DISCORD_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=
LOG_LEVEL=INFO
COMMAND_PREFIX=!
DATABASE_PATH=intelligence.db
HTTP_POOL_LIMIT=50
# Set false to skip public enrichment lookups (RDAP, DoH, ipwho.is, Tor list)
# when indicators are sensitive and must not leak to third parties.
ENRICHMENT_ENABLED=true

# Discord-native live ingestion. The bot listens on these channels for
# messages from sibling intel bots (OathNet Pro etc.); when a watchlist
# identifier appears, MeanMug runs autonomous analysis.
# Comma-separated channel IDs. Leave empty to disable ingestion.
INTEL_CHANNEL_IDS=
# Optional: send autonomous alerts here instead of replying in-channel.
ALERT_CHANNEL_ID=

# GLM-5.1 (OpenAI-compatible chat completions)
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-4.6
GLM_TIMEOUT=120
GLM_THINKING=true
GLM_TEMPERATURE=0.3
